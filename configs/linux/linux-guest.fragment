CONFIG_LOCALVERSION="-kvm-guest"

# Configs for Guest Kernel for kvmtool support
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# TODO: Decide if kvmtool's console device is AMBA_PL011 or 8250 for ARM FVP
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_RING=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_9P_FS=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_FB_VESA=y

CONFIG_KVM=n
